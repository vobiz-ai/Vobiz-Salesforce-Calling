# Copy to backend/.env and fill in. backend/.env is git-ignored.

# The public https:// address Vobiz reaches this server at. While developing,
# this is your tunnel, e.g. https://random-words.trycloudflare.com
PUBLIC_BASE_URL=

# Port to listen on. Point the tunnel here.
PORT=8080

# Who may frame the panel. The default covers Salesforce Lightning.
# SALESFORCE_FRAME_ANCESTORS=https://*.lightning.force.com https://*.my.salesforce.com https://*.force.com

# --- Optional: agents who sign in on the SIP direct tab -----------------------
# The Vobiz account tab needs nothing here: each agent types their own Auth ID
# and Auth Token, and the backend acts with those. The SIP direct tab creates
# no account session, so outbound calls from those endpoints are placed with
# this account, and only for the endpoint usernames listed.
# VOBIZ_AUTH_ID=
# VOBIZ_AUTH_TOKEN=
# SIP_DIRECT_USERNAMES=deskphone1234567,frontdesk7654321

# --- Optional tuning ---------------------------------------------------------
# Refuse any webhook that arrives without a Vobiz signature.
# REQUIRE_VOBIZ_SIGNATURE=true
# Seconds an inbound caller waits for Accept before voicemail.
# INBOUND_RING_SECONDS=45
# Seconds an outbound destination rings before the agent is released.
# OUTBOUND_RING_SECONDS=45
# How long a panel sign-in lasts.
# SESSION_HOURS=12
